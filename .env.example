# Copy to .env and fill in. .env is gitignored — never commit it.

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+12035550100

# Allowed senders (comma-separated E.164). Jeannie is NOT here.
SMS_ALLOWLIST=+12035551234

# Jeannie — isolated env var, never co-logged with ALLOWLIST
JEANNIE_NUMBER=+12035559876

# Vault path
# Windows dev:  VAULT_ROOT=c:\vaults\Pensieve
# Arch deploy:  VAULT_ROOT=/home/john/vault/Pensieve
VAULT_ROOT=c:\vaults\Pensieve

# Gemini Flash Lite
GEMINI_API_KEY=AIzaSy...

# Set 1 to skip LLM — returns raw text. For local dev without API key.
ENHANCE_MOCK=0

# Set 0 to disable /test endpoint in production
TEST_ENDPOINT_ENABLED=1
