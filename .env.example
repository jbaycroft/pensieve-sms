# Copy to .env and fill in. .env is gitignored — never commit it.

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+12035550100

# Allowed senders (comma-separated E.164). Jeannie is NOT here.
SMS_ALLOWLIST=+12035551234

# Jeannie — isolated env var, never co-logged with ALLOWLIST
JEANNIE_NUMBER=+12035559876

# Vault path
# Windows dev:  VAULT_ROOT=c:\vaults\Pensieve
# Arch deploy:  VAULT_ROOT=/home/john/vault/Pensieve
VAULT_ROOT=c:\vaults\Pensieve

# ── LLM backend ──────────────────────────────────────────────────────────────
# LLM_BACKEND selects the primary enhancement engine.
# The inactive backend is automatically used as a failover.
#
#   gemini  — Gemini Flash Lite via Google AI (requires GEMINI_API_KEY, needs internet)
#   ollama  — Local Ollama server          (air-gapped, no API key required)
LLM_BACKEND=ollama

# Gemini (used when LLM_BACKEND=gemini, or as fallback when ollama is primary)
# Leave blank if running fully offline with Ollama.
GEMINI_API_KEY=

# Ollama (used when LLM_BACKEND=ollama, or as fallback when gemini is primary)
# OLLAMA_BASE_URL defaults to http://localhost:11434 — only set if running remotely.
# OLLAMA_MODEL: recommended qwen2.5:1.5b (~1 GB RAM). Alternatives:
#   phi3.5           (~2 GB, better reasoning)
#   tinyllama        (~600 MB, lower quality)
#   qwen2.5:0.5b     (~400 MB, minimal)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
# OLLAMA_TIMEOUT=15

# Set 1 to skip LLM entirely — returns raw text. For CI / local dev.
ENHANCE_MOCK=0

# Set 0 to disable /test endpoint in production
TEST_ENDPOINT_ENABLED=1
